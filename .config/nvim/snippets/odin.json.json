{
  "odintest": {
    "prefix": "odintest",
    "body": [
      "@(test)",
      "${1:} :: proc(t : ^testing.T) {",
      "  ${0:}",
      "}"
    ]
  },
  "banner": {
    "prefix": "banner",
    "body": [
      "/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~",
      " *",
      " *  ${0:}",
      " *",
      " * ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/"
    ]
  },
  "docf": {
    "body": [
      "// ${1:}",
      "//",
      "// Arguments",
      "//  ${2:}: ${3:}",
      "//",
      "// Returns",
      "//  ${4:}"
    ],
    "prefix": "odindocf"
  },
  "flag": {
    "prefix": "flag",
    "body": [
      "/*",
      " * ${0:}",
      " */"
    ]
  },
  "odinaloc": {
    "prefix": "odinaloc",
    "body": "allocator := context.allocator"
  }
}
